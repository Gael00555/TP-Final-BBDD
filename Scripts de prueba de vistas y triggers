E)SELECT p.idPaciente, p.dni, p.apellido || ', ' || p.nombre AS paciente, COUNT(*) AS ingresos
FROM Paciente p, Visita v, Internacion i
WHERE v.idPaciente = p.idPaciente
  AND i.idVisita = v.idVisita
  AND i.fechaIngreso >= CURRENT_DATE - INTERVAL '1 month'
GROUP BY p.idPaciente, p.dni, p.apellido, p.nombre
ORDER BY ingresos DESC, p.apellido, p.nombre
LIMIT 10;


-- Vista: vw_servicios_disponibles
D)SELECT * FROM (SELECT DISTINCT ON (idBarrio)ciudad,barrio,centro_salud,COUNT(idServicio) AS cantidad_servicios
    FROM vw_servicios_disponibles
    GROUP BY idCiudad, ciudad, idBarrio, barrio, idCentro, centro_salud
    ORDER BY idBarrio, cantidad_servicios DESC
) 
ORDER BY ciudad, barrio;


-- B) Prueba para un servicio, día y horario específico ('Tomografia', 'Lunes', '10:00')
SELECT DISTINCT v.centro_salud, v.barrio, v.ciudad
FROM vw_servicios_disponibles v
WHERE v.servicio = 'Tomografia'
  AND (v.idServicio IN (SELECT idServicio FROM HorarioAtencion
WHERE idServicio IS NOT NULL AND diaSemana = 'Lunes'
AND horaApertura <= '10:00' AND '10:00' < horaCierre)
OR (v.idServicio NOT IN (SELECT idServicio FROM HorarioAtencion WHERE idServicio IS NOT NULL)
AND v.idCentro IN (SELECT idCentro FROM HorarioAtencion
WHERE idCentro IS NOT NULL AND diaSemana = 'Lunes'
AND horaApertura <= '10:00' AND '10:00' < horaCierre)))
ORDER BY v.ciudad, v.centro_salud;


