A)SELECT ciudad, COUNT(DISTINCT idPaciente) AS cantidad_pacientes
FROM vw_historial_visitas
WHERE diagnostico = 'Gripe' -- reemplazar por el diagnóstico buscado
GROUP BY idCiudad, ciudad
ORDER BY ciudad;


C)SELECT * FROM (SELECT DISTINCT ON (idCentro)barrio,centro_salud,medico,COUNT(DISTINCT idPaciente) AS pacientes_atendidos
    FROM vw_historial_visitas
    GROUP BY idBarrio, barrio, idCentro, centro_salud, idProfesional, medico
    ORDER BY idCentro, pacientes_atendidos DESC
) 
ORDER BY barrio, centro_salud;

