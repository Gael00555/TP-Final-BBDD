-- Vista: vw_servicios_disponibles
SELECT COUNT(*) FROM vw_servicios_disponibles;

SELECT servicio, barrio, ciudad
FROM vw_servicios_disponibles
WHERE centro_salud = 'Hospital Escuela Parana'
ORDER BY servicio;

-- Vista: vw_historial_visitas
SELECT COUNT(*) FROM vw_historial_visitas;

SELECT paciente_completo, CURRENT_DATE - fechaVisita AS dias_atras, medico, servicio, centro_salud, diagnostico
FROM vw_historial_visitas
WHERE idPaciente = 5
ORDER BY fechaVisita;

-- Vista: vw_pacientes_internados
SELECT paciente_completo, CURRENT_DATE - fechaIngreso AS dias_internado, centro_salud, atenciones_6_meses
FROM vw_pacientes_internados
ORDER BY paciente_completo;

